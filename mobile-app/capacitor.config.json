{
  "appId": "com.foursinteriors.orders",
  "appName": "4S Orders",
  "webDir": "www",
  "server": {
    "url": "https://pritish-dev.github.io/4s-orders/mobile-app/www/",
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#F04040"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "backgroundColor": "#F04040",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#F04040"
    }
  }
}
